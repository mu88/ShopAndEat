{
  "version": "3.0",
  "defaultProvider": "jsDelivr",
  "defaultDestination": "wwwroot",
  "libraries": [
    {
      "library": "bootstrap@4.3.1",
      "destination": "ShopAndEat/wwwroot/css/bootstrap",
      "fileMappings": [
        {
          "root": "dist/css",
          "destination": "ShopAndEat/wwwroot/css/bootstrap",
          "files": [
            "bootstrap.min.css",
            "bootstrap.min.css.map"
          ]
        }
      ]
    }
  ]
}
