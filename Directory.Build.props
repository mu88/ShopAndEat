<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Version>6.1.0</Version>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Private home app: unhandled interop failures intentionally propagate; reload instead of speculative recovery. -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>
</Project>
