@page "/article"
@rendermode InteractiveServer
@using DataLayer.EfClasses
@using DTO.Article
@using DTO.ArticleGroup
@using ServiceLayer
@using ShopAndEat.Models
@inject IArticleService ArticleService
@inject IArticleGroupService ArticleGroupService
@inject IJSRuntime Js
@* TODO mu88: Build translator *@

<EditForm Model="@_articleModel" OnSubmit="HandleSubmitAsync" FormName="ArticleForm">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="article-form">
        <InputText id="article-name" class="form-control article-form-name" placeholder="Name" aria-label="Name" @bind-Value="_articleModel.ArticleName" data-testid="article-name-input"/>
        <InputSelect id="article-group" class="form-select article-form-group" aria-label="Article Group" @bind-Value="_articleModel.ArticleGroupName" data-testid="article-group-select">
            <option>—</option>
            @foreach (var articleGroup in ArticleGroups.OrderBy(x => x.Name))
            {
                <option value="@articleGroup.Name">@articleGroup.Name</option>
            }
        </InputSelect>
        <InputCheckbox id="article-is-inventory" class="btn-check" @bind-Value="_articleModel.IsInventory" data-testid="article-is-inventory-checkbox"/>
        <label class="btn btn-outline-primary article-form-button" for="article-is-inventory" title="Inventory" aria-label="Inventory">
            <span class="icon icon-shelving-unit" aria-hidden="true"></span>
        </label>
        <button type="submit" class="btn btn-primary article-form-button" data-testid="article-save-button" title="Save" aria-label="Save">
            <span class="icon icon-check" aria-hidden="true"></span>
        </button>
    </div>
</EditForm>

<div class="article-grid mt-3" role="list" aria-label="Articles" data-testid="article-list">
    @foreach (var article in Articles)
    {
        <div class="article-item" role="listitem" data-testid="article-row-@article.ArticleId.Value">
            <div class="article-text">
                <div class="fw-semibold text-truncate lh-sm">@article.Name</div>
                <div class="small text-muted text-truncate lh-sm">@article.ArticleGroup.Name</div>
            </div>
            @if (article.IsInventory)
            {
                <span class="icon icon-shelving-unit text-primary" role="img" title="Inventory" aria-label="Inventory"></span>
            }
            <button class="btn btn-sm btn-link text-secondary p-1" @onclick="@(_ => EditArticleAsync(article.ArticleId.Value))" data-testid="edit-article-button-@article.ArticleId.Value" title="Edit article" aria-label="Edit article">
                <span class="icon icon-pencil" aria-hidden="true"></span>
            </button>
            <button class="btn btn-sm btn-link text-danger p-1" @onclick="@(_ => DeleteArticleAsync(article.ArticleId.Value))" data-testid="delete-article-button-@article.ArticleId.Value" title="Delete article" aria-label="Delete article">
                <span class="icon icon-trash" aria-hidden="true"></span>
            </button>
        </div>
    }
</div>

@code {

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadArticlesAsync();
        ArticleGroups = await ArticleGroupService.GetAllArticleGroupsAsync();
    }

    private async Task LoadArticlesAsync()
    {
        Articles = await ArticleService.GetAllArticlesAsync();
        if (Articles.Any())
        {
            _articleModel.ArticleGroupName = Articles.First().ArticleGroup.Name;
        }
    }

    private IReadOnlyList<ExistingArticleDto> Articles { get; set; } = [];

    private IReadOnlyList<ExistingArticleGroupDto> ArticleGroups { get; set; } = [];

    private readonly ArticleModel _articleModel = new();

    private async Task HandleSubmitAsync()
    {
        if (_articleModel.ArticleId == default)
        {
            var newArticle = new NewArticleDto(_articleModel.ArticleName, ArticleGroups.Single(x => x.Name == _articleModel.ArticleGroupName), _articleModel.IsInventory);
            await ArticleService.CreateArticleAsync(newArticle);
        }
        else
        {
            var updatedArticle = new ExistingArticleDto(new ArticleId(_articleModel.ArticleId), _articleModel.ArticleName, ArticleGroups.Single(x => x.Name == _articleModel.ArticleGroupName), _articleModel.IsInventory);
            await ArticleService.UpdateArticleAsync(updatedArticle);
            _articleModel.ArticleId = default;
        }

        await ShowSaveConfirmationAsync();

        await LoadArticlesAsync();
    }

    private async Task ShowSaveConfirmationAsync() => await Js.InvokeVoidAsync("window.alert", "Saved!");

    private async Task DeleteArticleAsync(int articleId)
    {
        await ArticleService.DeleteArticleAsync(new DeleteArticleDto(new ArticleId(articleId)));
        await LoadArticlesAsync();
    }

    private async Task EditArticleAsync(int articleId)
    {
        var article = Articles.Single(x => x.ArticleId.Value == articleId);
        _articleModel.ArticleId = article.ArticleId.Value;
        _articleModel.ArticleName = article.Name;
        _articleModel.ArticleGroupName = article.ArticleGroup.Name;
        _articleModel.IsInventory = article.IsInventory;
        await ScrollToTopAsync();
    }

    private async Task ScrollToTopAsync() => await Js.InvokeVoidAsync("window.scrollTo", 0, 0);

}
