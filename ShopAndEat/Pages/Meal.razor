@page "/"
@page "/meal"
@rendermode InteractiveServer
@using DataLayer.EfClasses
@using DTO.Meal
@using DTO.MealType
@using DTO.PurchaseItem
@using DTO.Recipe
@using DTO.Store
@using ServiceLayer
@using ShopAndEat.Models
@inject IMealService MealService
@inject IStoreService StoreService
@inject IRecipeService RecipeService
@inject IMealTypeService MealTypeService
@inject IJSRuntime Js
@inject TimeProvider TimeProvider
@* TODO mu88: Build translator *@

<div class="mb-3">
    <label class="form-label">
        Store:
        <select class="form-select" @onchange="SelectedStoreChanged" data-testid="meal-store-select">
            @foreach (var store in Stores)
        {
            <option value="@store.Name">@store.Name</option>
        }
        </select>
    </label>
</div>

@if (SelectedStore == null)
{
    <button class="btn btn-primary" disabled data-testid="get-shopping-list-button">Get shopping list</button>
}
else
{
    <button class="btn btn-primary" @onclick="GetShoppingListAsync" data-testid="get-shopping-list-button">Get shopping list</button>
}

<hr>

<table class="table table-striped table-hover align-middle">
    <caption>Meal plan</caption>
    <thead class="table-light">
        <tr>
            <th scope="col">Day</th>
            <th scope="col">Time</th>
            <th scope="col">Recipe</th>
            <th scope="col">Has been shopped</th>
            <th scope="col">Number of persons</th>
            <th scope="col"/>
            <th scope="col"/>
        </tr>
    </thead>
    <tbody>
        @foreach (var meal in Meals)
        {
            @if (meal.Day.Date == Today)
            {
                <tr class="table-success" data-testid="meal-row-@meal.MealId.Value">
                    <td>@meal.Day.ToShortDateString() (@meal.Day.ToString("dddd"))</td>
                    <td>@meal.MealType.Name</td>
                    <td>@meal.Recipe.Name</td>
                    <td data-testid="meal-has-been-shopped-@meal.MealId.Value">@meal.HasBeenShopped</td>
                    <td>@meal.NumberOfPersons</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="@(_ => DeleteMealAsync(meal.MealId.Value))" data-testid="delete-meal-button-@meal.MealId.Value" title="Delete meal" aria-label="Delete meal">
                            <span class="icon icon-trash" aria-hidden="true"></span>
                        </button>
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="@(_ => ToggleAsync(meal.MealId.Value))" data-testid="toggle-meal-button-@meal.MealId.Value" title="Toggle shopped status" aria-label="Toggle shopped status">
                            <span class="icon icon-refresh" aria-hidden="true"></span>
                        </button>
                    </td>
                </tr>
            }
            else
            {
                <tr data-testid="meal-row-@meal.MealId.Value">
                    <td>@meal.Day.ToShortDateString() (@meal.Day.ToString("dddd"))</td>
                    <td>@meal.MealType.Name</td>
                    <td>@meal.Recipe.Name</td>
                    <td data-testid="meal-has-been-shopped-@meal.MealId.Value">@meal.HasBeenShopped</td>
                    <td>@meal.NumberOfPersons</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="@(_ => DeleteMealAsync(meal.MealId.Value))" data-testid="delete-meal-button-@meal.MealId.Value" title="Delete meal" aria-label="Delete meal">
                            <span class="icon icon-trash" aria-hidden="true"></span>
                        </button>
                    </td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="@(_ => ToggleAsync(meal.MealId.Value))" data-testid="toggle-meal-button-@meal.MealId.Value" title="Toggle shopped status" aria-label="Toggle shopped status">
                            <span class="icon icon-refresh" aria-hidden="true"></span>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<EditForm Model="@_mealModel" OnSubmit="HandleSubmitAsync" FormName="MealForm">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <div class="mb-3">
        <label class="form-label">
            Recipe:
            <select class="form-select" @onchange="SelectedRecipeChanged" data-testid="meal-recipe-select">
                <option>Choose Recipe...</option>
                @foreach (var recipe in Recipes.OrderBy(x => x.Name))
                {
                    <option value="@recipe.Name">@recipe.Name</option>
                }
            </select>
        </label>
    </div>
    <div class="mb-3">
        <label class="form-label">
            Meal type:
            <InputSelect class="form-select" @bind-Value="_mealModel.MealTypeName" data-testid="meal-type-select">
                <option>Choose Meal Type...</option>
                @foreach (var mealType in MealTypes.OrderBy(x => x.Name))
                {
                    <option value="@mealType.Name">@mealType.Name</option>
                }
            </InputSelect>
        </label>
    </div>
    <div class="mb-3">
        <label class="form-label">
            Date:
            <InputDate class="form-control" @bind-Value="_mealModel.Date" data-testid="meal-date-input"/>
        </label>
    </div>
    <div class="mb-3">
        <label class="form-label">
            Number of Persons:
            <InputNumber class="form-control" @bind-Value="_mealModel.NumberOfPersons" data-testid="meal-persons-input"/>
        </label>
    </div>
    <div class="mb-3">
        <label class="form-label">
            Number of Days:
            <InputNumber class="form-control" @bind-Value="_mealModel.NumberOfDays" data-testid="meal-days-input"/>
        </label>
    </div>

    <button type="submit" class="btn btn-primary" data-testid="meal-save-button">Save</button>
</EditForm>

<hr>

@if (PurchaseItems.Any())
{
    <button class="btn btn-primary" @onclick="CopyToClipboardAsync">Copy to clipboard</button>
    <h2>Purchase items</h2>
    @foreach (var purchaseItem in PurchaseItems)
    {
        @purchaseItem.ToString()<br/>
    }
}



@code {

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadMealsAsync();
        Recipes = await RecipeService.GetAllRecipesAsync();
        MealTypes = await MealTypeService.GetAllMealTypesAsync();
        PurchaseItems = new List<NewPurchaseItemDto>();
        Stores = await StoreService.GetAllStoresAsync();
        SelectedStore = Stores.FirstOrDefault();
        _mealModel.Date = TimeProvider.GetLocalNow().DateTime.Date;
    }

    private DateTime Today => TimeProvider.GetLocalNow().DateTime.Date;

    private async Task LoadMealsAsync() => Meals = await MealService.GetFutureMealsAsync();

    private IReadOnlyList<ExistingMealDto> Meals { get; set; } = [];

    private IReadOnlyList<ExistingMealTypeDto> MealTypes { get; set; } = [];

    private IReadOnlyList<ExistingRecipeDto> Recipes { get; set; } = [];

    private IReadOnlyList<NewPurchaseItemDto> PurchaseItems { get; set; } = [];

    private IReadOnlyList<ExistingStoreDto> Stores { get; set; } = [];

    private ExistingStoreDto? SelectedStore { get; set; }

    private async Task GetShoppingListAsync()
    {
        PurchaseItems = await MealService.GetOrderedPurchaseItemsAsync(SelectedStore!);
        await LoadMealsAsync();
    }

    private async Task CopyToClipboardAsync() =>
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(Environment.NewLine, PurchaseItems));

    void SelectedStoreChanged(ChangeEventArgs e)
    {
        SelectedStore = Stores.Single(x => x.Name == e.Value?.ToString());
    }

    private readonly MealModel _mealModel = new();

    private async Task HandleSubmitAsync()
    {
        var newMeal = new NewMealDto(_mealModel.Date,
            MealTypes.Single(x => x.Name == _mealModel.MealTypeName),
            Recipes.Single(x => x.Name == _mealModel.RecipeName),
            _mealModel.NumberOfPersons,
            _mealModel.NumberOfDays);
        await MealService.CreateMealAsync(newMeal);
        await LoadMealsAsync();
    }

    private async Task DeleteMealAsync(int mealId)
    {
        await MealService.DeleteMealAsync(new DeleteMealDto(new MealId(mealId)));
        await LoadMealsAsync();
    }

    private async Task ToggleAsync(int mealId)
    {
        await MealService.ToggleMealAsync(mealId);
        await LoadMealsAsync();
    }

    private void SelectedRecipeChanged(ChangeEventArgs e)
    {
        if (e.Value is string recipeName)
        {
            _mealModel.NumberOfDays = Recipes.Single(recipe => recipe.Name == recipeName).NumberOfDays;
            _mealModel.NumberOfPersons = Recipes.Single(recipe => recipe.Name == recipeName).NumberOfPersons;
            _mealModel.RecipeName = recipeName;
            StateHasChanged();
        }
    }

}
