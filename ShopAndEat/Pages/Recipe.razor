@page "/recipe"
@rendermode InteractiveServer
@using DataLayer.EfClasses
@using DTO.Article
@using DTO.Ingredient
@using DTO.Recipe
@using DTO.Unit
@using ServiceLayer
@using ShopAndEat.Models
@inject IRecipeService RecipeService
@inject IArticleService ArticleService
@inject IUnitService UnitService
@inject IJSRuntime JS
@* TODO mu88: Build translator *@

<EditForm Model="@_recipeModel" OnSubmit="HandleSubmitAsync" FormName="RecipeForm">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <p>
        <label>
            Name:
            <InputText @bind-Value="_recipeModel.Name"/>
        </label>
    </p>
    <p>
        <label>
            Number of Days:
            <InputNumber @bind-Value="_recipeModel.NumberOfDays"/>
        </label>
    </p>
    <p>
        <label>
            Number of Persons:
            <InputNumber @bind-Value="_recipeModel.NumberOfPersons"/>
        </label>
    </p>
    <p>
        Ingredients:
    <table>
        <tr>
            <th>Quantity</th>
            <th>Unit</th>
            <th>Article</th>
        </tr>
        @for (var i = 0; i < NumberOfIngredients; i++)
        {
            var ingredientNumber = i;

            <tr>
                <td>
                    <input type="number" step=0.1 min=0 @bind="@SelectedQuantities[ingredientNumber]"/>
                </td>
                <td>
                    <select @bind="@SelectedUnitIds[ingredientNumber]">
                        <option>Choose Unit...</option>
                        @foreach (var unit in Units.OrderBy(x => x.Name))
                        {
                            <option value="@unit.UnitId.Value">@unit.Name</option>
                        }
                    </select>
                </td>
                <td>
                    <select @bind="@SelectedArticleIds[ingredientNumber]">
                        <option>Choose Article...</option>
                        @foreach (var article in Articles.OrderBy(x => x.Name))
                        {
                            <option value="@article.ArticleId.Value">@article.Name</option>
                        }
                    </select>
                </td>
            </tr>
        }
    </table>
    <label @onclick="AddIngredient">Add another ingredient</label>
    <label @onclick="DeleteLastIngredient">Delete last ingredient</label>
    </p>

    <button type="submit">Save</button>
</EditForm>

<table class="table table-striped">
    <caption>Recipes</caption>
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col"/>
        </tr>
    </thead>
    <tbody>
        @foreach (var recipe in Recipes)
        {
            <tr>
                <td>@recipe.Name</td>
                <td>
                    <button class="btn btn-primary" @onclick="@(e => DeleteRecipeAsync(recipe.RecipeId.Value))">❌</button>
                </td>
                <td>
                    <button class="btn btn-primary" @onclick="@(e => EditRecipeAsync(recipe.RecipeId.Value))">🖊</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadRecipesAsync();
        Units = await UnitService.GetAllUnitsAsync();
        Articles = await ArticleService.GetAllArticlesAsync();
        SelectedUnitIds = new List<int>();
        SelectedArticleIds = new List<int>();
        SelectedQuantities = new List<double>();
        AddIngredient();
    }

    private List<int> SelectedUnitIds { get; set; } = [];

    private List<int> SelectedArticleIds { get; set; } = [];

    private List<double> SelectedQuantities { get; set; } = [];

    private IReadOnlyList<ExistingArticleDto> Articles { get; set; } = [];

    private IReadOnlyList<ExistingUnitDto> Units { get; set; } = [];

    private async Task LoadRecipesAsync()
    {
        Recipes = await RecipeService.GetAllRecipesAsync();
    }

    private IReadOnlyList<ExistingRecipeDto> Recipes { get; set; } = [];

    private int NumberOfIngredients => SelectedArticleIds.Count;

    private readonly RecipeModel _recipeModel = new();

    private async Task HandleSubmitAsync()
    {
        var ingredients = BuildIngredients();

        if (_recipeModel.RecipeId == default)
        {
            var newRecipe = new NewRecipeDto(_recipeModel.Name, _recipeModel.NumberOfDays, _recipeModel.NumberOfPersons, ingredients);
            await RecipeService.CreateNewRecipeAsync(newRecipe);
        }
        else
        {
            var updatedRecipe = new UpdateRecipeDto(_recipeModel.Name, _recipeModel.NumberOfDays, _recipeModel.NumberOfPersons, ingredients, new RecipeId(_recipeModel.RecipeId));
            await RecipeService.UpdateRecipeAsync(updatedRecipe);
        }

        await ShowSaveConfirmationAsync();

        await LoadRecipesAsync();
    }

    private List<NewIngredientDto> BuildIngredients()
    {
        var ingredients = new List<NewIngredientDto>();
        for (var i = 0; i < NumberOfIngredients; i++)
        {
            ingredients.Add(new NewIngredientDto(Articles.Single(x => x.ArticleId.Value == SelectedArticleIds[i]),
                SelectedQuantities[i],
            Units.Single(x => x.UnitId.Value == SelectedUnitIds[i])));
        }

        return ingredients;
    }

    private async Task ShowSaveConfirmationAsync() => await JS.InvokeVoidAsync("window.alert", "Saved!");

    private void AddIngredient()
    {
        SelectedArticleIds.Add(default);
        SelectedQuantities.Add(default);
        SelectedUnitIds.Add(default);
    }

    private void DeleteLastIngredient()
    {
        var indexOfLastIngredient = NumberOfIngredients - 1;
        SelectedArticleIds.RemoveAt(indexOfLastIngredient);
        SelectedQuantities.RemoveAt(indexOfLastIngredient);
        SelectedUnitIds.RemoveAt(indexOfLastIngredient);
    }

    private async Task DeleteRecipeAsync(int recipeId)
    {
        await RecipeService.DeleteRecipeAsync(new DeleteRecipeDto(new RecipeId(recipeId)));
        await LoadRecipesAsync();
    }

    private async Task EditRecipeAsync(int recipeId)
    {
        var recipe = Recipes.Single(x => x.RecipeId.Value == recipeId);
        _recipeModel.Name = recipe.Name;
        _recipeModel.NumberOfDays = recipe.NumberOfDays;
        _recipeModel.NumberOfPersons = recipe.NumberOfPersons;
        SelectedArticleIds = recipe.Ingredients.Select(x => x.Article).Select(x => x.ArticleId.Value).ToList();
        SelectedQuantities = recipe.Ingredients.Select(x => x.Quantity).ToList();
        SelectedUnitIds = recipe.Ingredients.Select(x => x.Unit).Select(x => x.UnitId.Value).ToList();
        _recipeModel.RecipeId = recipe.RecipeId.Value;
        await ScrollToTopAsync();
    }

    private async Task ScrollToTopAsync() => await JS.InvokeVoidAsync("window.scrollTo", 0, 0);

}
