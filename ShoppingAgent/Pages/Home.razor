@page "/shopping"
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using ShoppingAgent.Resources
@using ShoppingAgent.Services
@using ShoppingAgent.Models
@using Markdig
@using Ganss.Xss
@inject IAgentService Agent
@inject IExtensionBridge Bridge
@inject ISessionService SessionService
@inject IStringLocalizer<Messages> L
@inject IJSRuntime JS
@inject TimeProvider TimeProvider
@inject IMistralChatClientProvider LlmProvider
@implements IDisposable

<PageTitle>ShopAndEat – @L["TabTitle"]</PageTitle>

<HeadContent>
    <style>
        html, body { overflow: hidden; }
        .main { display: flex; flex-direction: column; height: 100vh; }
        .main > .content { flex: 1; overflow: hidden; padding: 0 !important; min-height: 0; }
    </style>
</HeadContent>

<div class="chat-container">
    <header class="chat-header">
        <h1>@L["AppTitle"]</h1>
        <div class="header-actions">
            <div class="shop-selector">
                <select @onchange="OnShopChanged" disabled="@Agent.IsProcessing">
                    @foreach (var shop in Agent.AvailableShops)
                    {
                        <option value="@shop.Key" selected="@(shop.Key == Agent.SelectedShopKey)">
                            🛒 @shop.Name
                        </option>
                    }
                </select>
            </div>
            <div class="status-indicators">
                <span class="status-badge @(Bridge.IsExtensionConnected ? "connected" : "disconnected")">
                    @(Bridge.IsExtensionConnected ? L["ExtensionConnected"] : L["ExtensionNotConnected"])
                </span>
                <span class="status-badge @(_isLlmReady ? "connected" : "disconnected")">
                    @L["LlmReady"]
                </span>
            </div>
        </div>
    </header>

    <div class="chat-messages" id="chatMessages">
        @if (Agent.Messages.Count == 0)
        {
            <div class="welcome-message">
                <p>@L["WelcomeMessage"]</p>
                <p class="hint">@L["WelcomeHint"]</p>
            </div>
        }

        @foreach (var message in Agent.Messages)
        {
            <div class="chat-message @message.Role">
                <div class="message-content">
                    <span class="message-role">@(message.Role == "user" ? "👤" : "🤖")</span>
                    <div class="message-text">@((MarkupString)FormatMessage(message.Content))</div>
                </div>
                @if (message.IsStreaming)
                {
                    <span class="typing-indicator">●●●</span>
                }
            </div>
        }
    </div>

    <div class="chat-splitter" id="chatSplitter"></div>

    <div class="chat-input-area" id="chatInputArea">
        <div class="input-toolbar">
            <button class="toolbar-btn" data-testid="load-meal-plan" @onclick="LoadFromMealPlan" disabled="@Agent.IsProcessing"
                    title="@L["LoadFromMealPlan"]">
                📥 @L["LoadFromMealPlan"]
            </button>
            <button class="toolbar-btn" data-testid="copy-chat" @onclick="CopyChat" disabled="@(Agent.Messages.Count == 0)"
                    title="@L["CopyChat"]">
                @(_copyFeedback ? "✅" : "📋") @L["CopyChat"]
            </button>
            <button class="toolbar-btn" data-testid="clear-chat" @onclick="ClearChat" disabled="@Agent.IsProcessing"
                    title="@L["ClearChat"]">
                🗑️ @L["ClearChat"]
            </button>
        </div>
        <div class="input-row">
            <textarea @bind="_userInput"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="@L["InputPlaceholder"]"
                      disabled="@Agent.IsProcessing"
                      rows="1"></textarea>
            <button class="send-button" @onclick="SendMessage" disabled="@(Agent.IsProcessing || string.IsNullOrWhiteSpace(_userInput))">
                📤
            </button>
            @if (Agent.IsProcessing)
            {
                <button class="stop-button" @onclick="StopProcessing" title="@L["StopProcessing"]">
                    ⏹️
                </button>
            }
        </div>
    </div>
</div>

@code {
    private bool _copyFeedback;
    private bool _isLlmReady;
    private string _userInput = string.Empty;
    private CancellationTokenSource? _cts;
    private readonly Action _onConnectionChanged;
    private readonly Action _onAgentStateChanged;

    public Home()
    {
        // Store the handlers as fields so the exact same delegate instances
        // can be unsubscribed again in Dispose, avoiding a memory leak.
        _onConnectionChanged = () => InvokeAsync(StateHasChanged);
        _onAgentStateChanged = () => InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Bridge.OnConnectionChanged += _onConnectionChanged;
            Agent.OnStateChanged += _onAgentStateChanged;

            await Bridge.InitializeAsync(CancellationToken.None);
            await Agent.InitializeAsync(cancellationToken: CancellationToken.None);
            _isLlmReady = await LlmProvider.CheckConnectionAsync(CancellationToken.None);
            StateHasChanged();
            await ScrollToBottomAsync();
        }
        else
        {
            try
            {
                await JS.InvokeVoidAsync("restoreDetailsStates");
            }
            catch (JSDisconnectedException)
            {
                // Component was disposed (e.g. navigation away) before the JS interop call completed - safe to ignore.
            }
        }
    }

    private async Task OnShopChanged(ChangeEventArgs e)
    {
        var shopKey = e.Value?.ToString();
        if (!string.IsNullOrEmpty(shopKey) && shopKey != Agent.SelectedShopKey)
        {
            await Agent.SwitchShopAsync(shopKey, CancellationToken.None);
            await JS.InvokeVoidAsync("clearDetailsStates");
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || Agent.IsProcessing)
        {
            return;
        }

        var input = _userInput.Trim();
        _userInput = string.Empty;

        var assistantMessage = await AppendUserAndAssistantMessagesAsync(input);

        _cts = new CancellationTokenSource();
        try
        {
            await StreamResponseAsync(input, assistantMessage);
        }
        catch (OperationCanceledException)
        {
            assistantMessage.Content += $"\n\n⛔ {L["ProcessingStopped"]}";
        }
        finally
        {
            _cts.Dispose();
            _cts = null;
        }

        assistantMessage.IsStreaming = false;
        StateHasChanged();
    }

    private async Task<ChatMessage> AppendUserAndAssistantMessagesAsync(string input)
    {
        Agent.AddMessage(new ChatMessage { Role = "user", Content = input, Timestamp = TimeProvider.GetUtcNow() });

        var assistantMessage = new ChatMessage { Role = "assistant", Content = string.Empty, IsStreaming = true, Timestamp = TimeProvider.GetUtcNow() };
        Agent.AddMessage(assistantMessage);
        StateHasChanged();
        await ScrollToBottomAsync();

        return assistantMessage;
    }

    private async Task StreamResponseAsync(string input, ChatMessage assistantMessage)
    {
        await foreach (var chunk in Agent.ProcessMessageAsync(input, _cts!.Token))
        {
            assistantMessage.Content += chunk;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private void StopProcessing()
    {
        _cts?.Cancel();
    }

    private async Task CopyChat()
    {
        if (Agent.Messages.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        foreach (var message in Agent.Messages)
        {
            var role = message.Role == "user" ? "👤 User" : "🤖 Assistant";
            sb.AppendLine($"{role}:");
            sb.AppendLine(message.Content);
            sb.AppendLine();
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        _copyFeedback = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copyFeedback = false;
        StateHasChanged();
    }

    private async Task ClearChat()
    {
        await Agent.SwitchShopAsync(Agent.SelectedShopKey!);
        await JS.InvokeVoidAsync("clearDetailsStates");
        StateHasChanged();
    }

    private async Task LoadFromMealPlan()
    {
        var ingredients = await SessionService.GetIngredientListAsync();
        if (ingredients.Count == 0)
        {
            Agent.AddMessage(new ChatMessage { Role = "assistant", Content = L["NoIngredientsFound"].Value, Timestamp = TimeProvider.GetUtcNow() });
            StateHasChanged();
            return;
        }

        _userInput = string.Join("\n", ingredients.Select(i => i.Text));
        StateHasChanged();
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('chatMessages')?.scrollTo(0, document.getElementById('chatMessages').scrollHeight)");
        }
        catch (JSDisconnectedException)
        {
            // Component was disposed (e.g. navigation away) before the JS interop call completed - safe to ignore.
        }
    }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private static readonly HtmlSanitizer Sanitizer = CreateSanitizer();

    private static HtmlSanitizer CreateSanitizer()
    {
        var sanitizer = new HtmlSanitizer();

        // HtmlToolResultRenderer emits "class" attributes (tool-group/tool-call/tool-result) that
        // app.css styles; the default allow-list drops "class", which silently breaks that styling.
        // Safe to allow: all dynamic parts of the rendered HTML are already WebUtility.HtmlEncode'd,
        // so this does not reopen the XSS hole the sanitizer exists for.
        sanitizer.AllowedAttributes.Add("class");

        return sanitizer;
    }

    private static string FormatMessage(string content)
    {
        if (string.IsNullOrEmpty(content))
        {
            return string.Empty;
        }

        var html = Markdown.ToHtml(content, MarkdownPipeline);

        // The LLM-generated text may embed malicious HTML/JS (prompt injection); sanitize
        // after Markdown conversion and before the result is ever wrapped in a MarkupString.
        return Sanitizer.Sanitize(html);
    }

    public void Dispose()
    {
        Bridge.OnConnectionChanged -= _onConnectionChanged;
        Agent.OnStateChanged -= _onAgentStateChanged;
        _cts?.Cancel();
        _cts?.Dispose();

        // IExtensionBridge is a scoped DI service, not owned by this component — the DI container
        // disposes it when the circuit's scope ends; disposing it here too would risk a double-dispose.
    }
}
